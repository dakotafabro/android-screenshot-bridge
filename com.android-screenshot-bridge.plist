<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.android-screenshot-bridge</string>
    <key>ProgramArguments</key>
    <array>
        <!-- Update this path to where you installed the script -->
        <string>/Users/YOUR_USERNAME/.local/bin/android-screenshot-sync.sh</string>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/tmp/android-screenshot-sync.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/android-screenshot-sync.log</string>
</dict>
</plist>
